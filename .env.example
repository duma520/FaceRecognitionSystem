# ============================================================================
#  人脸识别系统 - 环境变量模板   (.env.example)
#  v2.0.0
# ----------------------------------------------------------------------------
#  用法：把本文件复制为 .env，再填入真实值。
#      copy .env.example .env          (Windows CMD)
#      Copy-Item .env.example .env     (PowerShell)
#  .env 存放真实密钥，.env.example 只放空模板，可以安全分享。
# ============================================================================

# 人脸数据库（SQLite 文件路径；留空 = 项目根目录\face_database.db）
FACE_DB_PATH=

# 预留：MySQL / PostgreSQL 连接信息
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# 第三方 API 密钥
API_KEY=
API_SECRET=
API_BASE_URL=

# 网络代理密码
PROXY_PASSWORD=
